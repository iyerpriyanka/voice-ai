#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
output_dir="$(mktemp -d)"
trap 'rm -rf "$output_dir"' EXIT

validate_result() {
  local output_file="$1"
  local expected_decision="$2"

  python3 - "$output_file" "$expected_decision" <<'PY'
import json
import sys

output_path, expected_decision = sys.argv[1:]
result = json.loads(open(output_path, encoding="utf-8").read())
if result.get("status") != "pass":
    raise SystemExit(f"{output_path}: expected pass, got {result}")
if expected_decision and result.get("final_decision") != expected_decision:
    raise SystemExit(
        f"{output_path}: expected final_decision={expected_decision}, got {result.get('final_decision')}"
    )
PY
}

validate_failure_code() {
  local output_file="$1"
  local expected_code="$2"

  python3 - "$output_file" "$expected_code" <<'PY'
import json
import sys

output_path, expected_code = sys.argv[1:]
result = json.loads(open(output_path, encoding="utf-8").read())
if result.get("status") != "fail":
    raise SystemExit(f"{output_path}: expected fail, got {result}")
issues = result.get("issues") or result.get("errors") or []
codes = {issue.get("code") for issue in issues}
if expected_code not in codes:
    raise SystemExit(f"{output_path}: expected {expected_code}, got {sorted(codes)}")
PY
}

for agent_root in .codex .claude; do
  runner="$repo_root/$agent_root/orchestrator/scripts/hook-run.py"
  lifecycle_input="$repo_root/$agent_root/orchestrator/examples/lifecycle-input.json"

  for stage in pre-implementation post-implementation post-verification post-review; do
    output_file="$output_dir/${agent_root#.}-$stage.json"
    python3 "$runner" --stage "$stage" --input "$lifecycle_input" --output "$output_file"
    case "$stage" in
      post-verification) validate_result "$output_file" ready_for_review ;;
      post-review) validate_result "$output_file" ready_to_ship ;;
      *) validate_result "$output_file" "" ;;
    esac
  done

  python3 - "$lifecycle_input" "$output_dir/${agent_root#.}-self-review.json" <<'PY'
import json
import sys

source_path, output_path = sys.argv[1:]
payload = json.loads(open(source_path, encoding="utf-8").read())
owner = next(iter(payload["task_plan"]["ownership"].values()))
payload["review"]["reviewer"] = owner
payload["meta"]["triggered_by"] = owner
with open(output_path, "w", encoding="utf-8") as output_file:
    json.dump(payload, output_file)
PY
  python3 "$runner" --stage post-review \
    --input "$output_dir/${agent_root#.}-self-review.json" \
    --output "$output_dir/${agent_root#.}-self-review-result.json"
  validate_failure_code "$output_dir/${agent_root#.}-self-review-result.json" REVIEWER_NOT_INDEPENDENT

  python3 - "$lifecycle_input" "$output_dir/${agent_root#.}-missing-command.json" <<'PY'
import json
import sys

source_path, output_path = sys.argv[1:]
payload = json.loads(open(source_path, encoding="utf-8").read())
payload["verification"]["commands"] = []
with open(output_path, "w", encoding="utf-8") as output_file:
    json.dump(payload, output_file)
PY
  python3 "$runner" --stage post-verification \
    --input "$output_dir/${agent_root#.}-missing-command.json" \
    --output "$output_dir/${agent_root#.}-missing-command-result.json"
  validate_failure_code "$output_dir/${agent_root#.}-missing-command-result.json" REQUIRED_COMMANDS_MISSING

  python3 - "$lifecycle_input" "$output_dir/${agent_root#.}-missing-approval.json" <<'PY'
import json
import sys

source_path, output_path = sys.argv[1:]
payload = json.loads(open(source_path, encoding="utf-8").read())
payload["task_plan"]["discussion"]["decision"] = "revise"
with open(output_path, "w", encoding="utf-8") as output_file:
    json.dump(payload, output_file)
PY
  python3 "$runner" --stage pre-implementation \
    --input "$output_dir/${agent_root#.}-missing-approval.json" \
    --output "$output_dir/${agent_root#.}-missing-approval-result.json"
  validate_failure_code "$output_dir/${agent_root#.}-missing-approval-result.json" SCHEMA_VALIDATION_FAILED

  python3 - "$lifecycle_input" "$output_dir/${agent_root#.}-missing-implementation.json" <<'PY'
import json
import sys

source_path, output_path = sys.argv[1:]
payload = json.loads(open(source_path, encoding="utf-8").read())
payload.pop("implementation")
with open(output_path, "w", encoding="utf-8") as output_file:
    json.dump(payload, output_file)
PY
  python3 "$runner" --stage post-review \
    --input "$output_dir/${agent_root#.}-missing-implementation.json" \
    --output "$output_dir/${agent_root#.}-missing-implementation-result.json"
  validate_failure_code "$output_dir/${agent_root#.}-missing-implementation-result.json" SCHEMA_VALIDATION_FAILED

  python3 - "$lifecycle_input" "$output_dir/${agent_root#.}-missing-envelope.json" <<'PY'
import json
import sys

source_path, output_path = sys.argv[1:]
payload = json.loads(open(source_path, encoding="utf-8").read())
payload.pop("version")
with open(output_path, "w", encoding="utf-8") as output_file:
    json.dump(payload, output_file)
PY
  python3 "$runner" --stage post-review \
    --input "$output_dir/${agent_root#.}-missing-envelope.json" \
    --output "$output_dir/${agent_root#.}-missing-envelope-result.json"
  validate_failure_code "$output_dir/${agent_root#.}-missing-envelope-result.json" SCHEMA_VALIDATION_FAILED

  python3 - "$lifecycle_input" "$output_dir/${agent_root#.}-wrong-run.json" <<'PY'
import json
import sys

source_path, output_path = sys.argv[1:]
payload = json.loads(open(source_path, encoding="utf-8").read())
payload["orchestration"]["run_id"] = "unrelated-run"
with open(output_path, "w", encoding="utf-8") as output_file:
    json.dump(payload, output_file)
PY
  python3 "$runner" --stage post-review \
    --input "$output_dir/${agent_root#.}-wrong-run.json" \
    --output "$output_dir/${agent_root#.}-wrong-run-result.json"
  validate_failure_code "$output_dir/${agent_root#.}-wrong-run-result.json" ORCA_RUN_MISMATCH
done

panel="$output_dir/orca-development-panel.html"
python3 "$repo_root/bin/orca-development-panel" \
  --input "$repo_root/.codex/orchestrator/examples/lifecycle-input.json" \
  --output "$panel" >/dev/null
grep -q "Ready To Ship" "$panel"
grep -q "7/7 stages complete" "$panel"

injection_input="$output_dir/orca-development-panel-injection.json"
python3 - "$repo_root/.codex/orchestrator/examples/lifecycle-input.json" "$injection_input" <<'PY'
import json
import sys

source_path, output_path = sys.argv[1:]
payload = json.loads(open(source_path, encoding="utf-8").read())
payload["task"]["service"] = "<script>alert('panel')</script>"
with open(output_path, "w", encoding="utf-8") as output_file:
    json.dump(payload, output_file)
PY
injection_panel="$output_dir/orca-development-panel-injection.html"
python3 "$repo_root/bin/orca-development-panel" --input "$injection_input" --output "$injection_panel" >/dev/null
grep -q "&lt;script&gt;alert(&#x27;panel&#x27;)&lt;/script&gt;" "$injection_panel"
if grep -q "<script>alert('panel')</script>" "$injection_panel"; then
  echo "Panel output contains unescaped input." >&2
  exit 1
fi

collision_input="$output_dir/orca-development-panel-collision.json"
cp "$repo_root/.codex/orchestrator/examples/lifecycle-input.json" "$collision_input"
if python3 "$repo_root/bin/orca-development-panel" \
  --input "$collision_input" --output "$collision_input" >/dev/null 2>&1; then
  echo "Panel input/output collision unexpectedly succeeded." >&2
  exit 1
fi
python3 -m json.tool "$collision_input" >/dev/null

collision_symlink="$output_dir/orca-development-panel-collision-link"
ln -s "$collision_input" "$collision_symlink"
if python3 "$repo_root/bin/orca-development-panel" \
  --input "$collision_input" --output "$collision_symlink" >/dev/null 2>&1; then
  echo "Panel symlink input/output collision unexpectedly succeeded." >&2
  exit 1
fi

collision_hardlink="$output_dir/orca-development-panel-collision-hardlink"
ln "$collision_input" "$collision_hardlink"
if python3 "$repo_root/bin/orca-development-panel" \
  --input "$collision_input" --output "$collision_hardlink" >/dev/null 2>&1; then
  echo "Panel hard-link input/output collision unexpectedly succeeded." >&2
  exit 1
fi

malformed_input="$output_dir/orca-development-panel-malformed.json"
printf '{invalid json' >"$malformed_input"
if python3 "$repo_root/bin/orca-development-panel" \
  --input "$malformed_input" --output "$output_dir/malformed.html" >/dev/null 2>&1; then
  echo "Malformed panel input unexpectedly succeeded." >&2
  exit 1
fi

ORCA_CLI_COMMAND='"/path with spaces/orca" --environment local' \
  python3 - "$repo_root/bin/orca-development-panel" <<'PY'
import importlib.machinery
import sys

module = importlib.machinery.SourceFileLoader("orca_development_panel", sys.argv[1]).load_module()
assert module.resolve_orca_command() == ["/path with spaces/orca", "--environment", "local"]
PY

run_mock="$output_dir/mock-orca-run"
run_log="$output_dir/orca-run-calls.jsonl"
cat >"$run_mock" <<'PY'
#!/usr/bin/env python3
import json
import os
import sys

args = sys.argv[1:]
with open(os.environ["ORCA_RUN_LOG"], "a", encoding="utf-8") as log:
    log.write(json.dumps(args) + "\n")
if args[:2] == ["status", "--json"]:
    payload = {"result": {"app": {"running": True}, "runtime": {"reachable": True}}}
elif args[:2] == ["orchestration", "run-create"]:
    payload = {"result": {"run": {"id": "run_flow"}}}
elif args[:2] == ["orchestration", "task-create"]:
    title = args[args.index("--task-title") + 1]
    identifiers = {
        "Understand and plan": "task_plan",
        "Draft RFC": "task_rfc",
        "Challenge plan and RFC": "task_challenge",
    }
    payload = {"result": {"task": {"id": identifiers[title]}}}
elif args[:2] == ["orchestration", "worker-start"]:
    payload = {"result": {"dispatch": {"id": "dispatch_planner"}}}
else:
    raise SystemExit(f"unexpected command: {args}")
print(json.dumps(payload))
PY
chmod +x "$run_mock"
mkdir -p "$output_dir/run-worktree/rfcs"
if (
  cd "$output_dir/run-worktree"
  ORCA_CLI_COMMAND="$run_mock" ORCA_RUN_LOG="$run_log" \
    bash "$repo_root/bin/orca-development-run" "historical number" codex rfcs/0016-new-format.md \
    >/dev/null 2>&1
); then
  echo "Historical RFC number unexpectedly succeeded." >&2
  exit 1
fi
(
  cd "$output_dir/run-worktree"
  ORCA_CLI_COMMAND="$run_mock" ORCA_RUN_LOG="$run_log" \
    bash "$repo_root/bin/orca-development-run" "test objective" codex rfcs/0043-flow-test.md \
    >"$output_dir/orca-development-run.out"
)
touch "$output_dir/run-worktree/rfcs/0044-collision.md"
if (
  cd "$output_dir/run-worktree"
  ORCA_CLI_COMMAND="$run_mock" ORCA_RUN_LOG="$run_log" \
    bash "$repo_root/bin/orca-development-run" "collision" codex rfcs/0044-collision.md \
    >/dev/null 2>&1
); then
  echo "Existing RFC path collision unexpectedly succeeded." >&2
  exit 1
fi

python3 - "$run_log" <<'PY'
import json
import sys

calls = [json.loads(line) for line in open(sys.argv[1], encoding="utf-8")]
task_calls = [call for call in calls if call[:2] == ["orchestration", "task-create"]]
worker_calls = [call for call in calls if call[:2] == ["orchestration", "worker-start"]]
if len(task_calls) != 3:
    raise SystemExit(f"expected three planning tasks, got {len(task_calls)}")
if len(worker_calls) != 1:
    raise SystemExit(f"expected one planner dispatch, got {len(worker_calls)}")
PY

cmp -s .codex/orchestrator/scripts/hook-run.py .claude/orchestrator/scripts/hook-run.py
cmp -s .codex/orchestrator/schemas/envelope.schema.json .claude/orchestrator/schemas/envelope.schema.json
echo "Development process validation passed"
