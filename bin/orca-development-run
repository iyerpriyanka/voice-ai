#!/usr/bin/env bash
set -euo pipefail

objective="${1:-}"
planner_agent="${2:-}"
rfc_path="${3:-}"

if [[ -z "$objective" || -z "$planner_agent" || -z "$rfc_path" ]]; then
  echo "Usage: $0 <objective> <planner-agent> <unused-rfc-path>" >&2
  exit 2
fi

if [[ "$rfc_path" == /* || ! "$rfc_path" =~ ^rfcs/[0-9]{4}-[a-z0-9]+([a-z0-9-]*[a-z0-9])?\.md$ ]]; then
  echo "RFC path must be a relative unused path matching rfcs/NNNN-short-name.md." >&2
  exit 2
fi

rfc_number="${rfc_path#rfcs/}"
rfc_number="${rfc_number%%-*}"
if (( 10#$rfc_number < 17 )); then
  echo "New RFC numbers must be 0017 or later; earlier RFCs use the historical format." >&2
  exit 2
fi

if [[ -e "$rfc_path" || -L "$rfc_path" ]]; then
  echo "RFC path already exists: $rfc_path" >&2
  exit 2
fi

if [[ -n "${ORCA_CLI_COMMAND:-}" ]]; then
  read -r -a orca_cmd <<<"$ORCA_CLI_COMMAND"
elif [[ -n "${ORCA_DEV_REPO_ROOT:-}" ]]; then
  orca_cmd=(orca-dev)
elif [[ "$(uname -s)" == "Linux" ]]; then
  orca_cmd=(orca-ide)
else
  orca_cmd=(orca)
fi

if ! command -v "${orca_cmd[0]}" >/dev/null 2>&1; then
  echo "Orca CLI is not installed or not on PATH." >&2
  exit 1
fi

echo "Starting Governed workflow. Use the normal agent flow for Fast or Standard work." >&2

run_orca() {
  "${orca_cmd[@]}" "$@"
}

status_response="$(run_orca status --json)"
printf '%s' "$status_response" | python3 -c '
import json
import sys

payload = json.load(sys.stdin)
result = payload.get("result") or {}
app = result.get("app") or {}
runtime = result.get("runtime") or {}
if not app.get("running") or not runtime.get("reachable"):
    raise SystemExit("Orca app/runtime is not running or reachable. Start Orca and enable orchestration.")
'

extract_id() {
  local kind="$1"
  python3 -c '
import json
import sys

kind = sys.argv[1]
payload = json.load(sys.stdin)
preferred = {
    "run": ("runId", "run_id"),
    "task": ("taskId", "task_id"),
}

def find(value):
    if isinstance(value, dict):
        for key in preferred[kind]:
            candidate = value.get(key)
            if isinstance(candidate, str) and candidate:
                return candidate
        nested = value.get(kind)
        if isinstance(nested, dict):
            candidate = nested.get("id")
            if isinstance(candidate, str) and candidate:
                return candidate
        for child in value.values():
            candidate = find(child)
            if candidate:
                return candidate
    elif isinstance(value, list):
        for child in value:
            candidate = find(child)
            if candidate:
                return candidate
    return None

identifier = find(payload)
if not identifier:
    raise SystemExit(f"Unable to find {kind} id in Orca response")
print(identifier)
' "$kind"
}

run_response="$(run_orca orchestration run-create --objective "$objective" --json)"
run_id="$(printf '%s' "$run_response" | extract_id run)"

create_task() {
  local title="$1"
  local spec="$2"
  local deps="${3:-}"
  local response

  if [[ -n "$deps" ]]; then
    response="$(run_orca orchestration task-create --run "$run_id" --task-title "$title" --spec "$spec" --deps "$deps" --json)"
  else
    response="$(run_orca orchestration task-create --run "$run_id" --task-title "$title" --spec "$spec" --json)"
  fi
  printf '%s' "$response" | extract_id task
}

planner_task="$(create_task \
  "Understand and plan" \
  "Investigate: $objective. Use the task-planner role and task-plan template. Do not edit repository files. Produce verified context, acceptance criteria, non-goals, explicit path ownership, principle decisions, risks, exact verification commands, and open questions in the task output. Hand the completed plan to the RFC author; do not approve it.")"

rfc_task="$(create_task \
  "Draft RFC" \
  "Draft and revise the RFC for: $objective. Use rfcs/TEMPLATE.md and the rfc-author role. The only path you may create or edit is $rfc_path. Record context, decision, contracts and ownership, rejected alternatives, consequences and risks, rollout and rollback, verification, and approval. Complete every risk row with an impact or reasoned N/A and resolve every open question before acceptance. Keep file-level implementation detail in the task plan. Keep the status Draft until the challenge is resolved and approval is recorded. Do not edit the RFC index or create sidecar artifacts." \
  "[\"$planner_task\"]")"

challenger_task="$(create_task \
  "Challenge plan and RFC" \
  "Independently challenge the completed plan and RFC at $rfc_path for: $objective. Use the plan-challenger role and remain read-only. Verify the RFC matches the plan, all risk rows are justified, and no open question remains. Identify a simpler solution, ownership conflicts, missing contracts, unsafe failure paths, weak tests, and rollout risks. Return approve, revise, or block with evidence in the task output. A material change after acceptance requires a new RFC that supersedes this decision. Allow at most two revision rounds, then block and escalate unresolved decisions." \
  "[\"$rfc_task\"]")"

planner_response="$(run_orca orchestration worker-start \
  --run "$run_id" \
  --task "$planner_task" \
  --worktree current \
  --agent "$planner_agent" \
  --json)"

cat <<EOF
Orca RFC planning run created.

Run:             $run_id
Planner task:    $planner_task
RFC author task: $rfc_task
Challenge task:  $challenger_task
RFC path:         $rfc_path

Only the planner worker has started. Implementation, verification, and review
tasks must not be created until challenge findings are resolved, reviewer or owner
approval is recorded, and the RFC status is Accepted.

After approval, create implementation, verification, and review tasks with the accepted
RFC and task plan as their scope.

Planner receipt:
$planner_response
EOF
